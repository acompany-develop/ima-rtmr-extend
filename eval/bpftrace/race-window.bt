#!/usr/bin/env bpftrace
// SPDX-License-Identifier: GPL-2.0-only
// Copyright (c) 2026 Acompany Co., Ltd.
//
// Measure the time delta between
//   E1: ima_add_template_entry returns success (entry visible in ima_measurements)
//   E2: ima_rtmr_do_extend returns (kernel_write to the RTMR sysfs finished)
//
// Both events fire per IMA entry but in different contexts:
//   - E1: arbitrary task / interrupt context inside an IMA hook
//   - E2: a kworker thread for the ima_rtmr ordered workqueue
//
// Because the kretprobe handler in this module only kicks the worker (it does
// not carry per-entry payload), we cannot directly pair E1 with E2 per entry.
// Instead we measure the macro race window as
//   delta = E2_timestamp - last_E1_timestamp_before_E2
// which is the canonical "how stale was the RTMR when entry N became visible".
//
// Per-entry pairing would require a tracepoint we don't have. The macro view
// captures the worst-case observation latency a verifier would see.
//
// Run while the workload is active. Cancel with Ctrl-C; histograms print on exit.

BEGIN {
    printf("tracing IMA->RTMR race window. Ctrl-C to end.\n");
}

kretprobe:ima_add_template_entry
/ retval == 0 /
{
    @last_e1_ns = nsecs;
    @e1_count++;
}

kretprobe:ima_rtmr_do_extend
{
    $now = nsecs;
    if (@last_e1_ns > 0) {
        $delta = $now - @last_e1_ns;
        @race_ns = hist($delta);
        @race_ns_lin = lhist($delta, 0, 10000000, 100000); // 0..10 ms in 100 us buckets
        @max_ns = max($delta);
    }
    @e2_count++;
}

interval:s:10 {
    printf("[%u] e1=%lu e2=%lu max_ns=%lu\n", elapsed/1000000000, @e1_count, @e2_count, @max_ns);
}

END {
    printf("\n=== race window distribution (ns, log2 buckets) ===\n");
    print(@race_ns);
    printf("\n=== race window distribution (0..10ms linear, 100us buckets) ===\n");
    print(@race_ns_lin);
    printf("\nmax_ns=%lu e1=%lu e2=%lu\n", @max_ns, @e1_count, @e2_count);
    clear(@last_e1_ns);
}
